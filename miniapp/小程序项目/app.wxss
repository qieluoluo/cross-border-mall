page {
  background-color: #f6f7f9;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.container {
  min-height: 100%;
  box-sizing: border-box;
}

.btn-primary {
  background: #f97316;
  color: #fff;
  border-radius: 48rpx;
  font-weight: 600;
}

.btn-primary::after {
  border: none;
}
