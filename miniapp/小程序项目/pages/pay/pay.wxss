/* pages/pay/pay.wxss */
page {
  background: #f5f5f5;
}

.container {
  padding: 0;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.amount-card {
  background: #fff;
  padding: 60rpx 30rpx;
  text-align: center;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.label {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-bottom: 16rpx;
}

.amount {
  font-size: 80rpx;
  color: #ff6b6b;
  font-weight: bold;
  display: block;
}

.pay-info {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.info-value.alipay {
  color: #1677ff;
  font-weight: bold;
}

.pay-tip {
  background: #fff;
  padding: 30rpx;
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.tip-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.pay-btn {
  background: linear-gradient(135deg, #1677ff, #4096ff);
  color: #fff;
  border-radius: 50rpx;
  margin: 0 30rpx 20rpx;
  padding: 28rpx 0;
  font-size: 34rpx;
  font-weight: bold;
}

.pay-btn[disabled] {
  background: #ccc;
  color: #fff;
}

.loading-tip {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}
