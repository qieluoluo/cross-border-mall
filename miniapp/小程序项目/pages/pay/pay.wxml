<!-- pages/pay/pay.wxml -->
<view class="container">
  <view class="amount-card">
    <text class="label">支付金额</text>
    <text class="amount">¥{{amount}}</text>
  </view>

  <view class="pay-info" wx:if="{{outTradeNo}}">
    <view class="info-row">
      <text class="info-label">订单号</text>
      <text class="info-value">{{outTradeNo}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">支付方式</text>
      <text class="info-value alipay">支付宝</text>
    </view>
  </view>

  <view class="pay-tip">
    <text class="tip-icon">💳</text>
    <text class="tip-text">{{outTradeNo ? '您的支付请求已创建，请点击下方按钮确认完成支付' : '点击下方按钮创建支付请求'}}</text>
  </view>

  <button class="pay-btn" bindtap="doPay">
    确认支付 ¥{{amount}}
  </button>

  <view class="loading-tip" wx:if="{{isCreating}}">
    <text>正在连接支付系统...</text>
  </view>
</view>
