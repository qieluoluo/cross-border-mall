/* pages/admin/create/create.wxss */

page {
  margin: 0;
  padding: 0;
  background-color: #f5f7fa;
}

.page {
  margin: 0;
  padding: 0;
  min-height: 100vh;
  background-color: #f5f7fa;
}

/* ===== 表单卡片 ===== */
.form-card {
  background: #ffffff;
  margin: 0;
  padding: 0;
  width: 100%;
  box-sizing: border-box;
  border-bottom: 1px solid #f0f0f0;
}

/* 每个输入项 */
.form-field {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  background: #fff;
  border-bottom: 1px solid #f5f5f5;
  width: 100%;
  box-sizing: border-box;
}

.field-icon {
  font-size: 40rpx;
  width: 60rpx;
  color: #7f8c8d;
}

.field-input {
  flex: 1;
  font-size: 30rpx;
  color: #1a2c3e;
  padding: 8rpx 0;
}

.placeholder {
  color: #bbb;
}

/* picker 特殊样式 */
.picker-field {
  position: relative;
}

.picker-text {
  color: #1a2c3e;
}

.picker-arrow {
  font-size: 40rpx;
  color: #ccc;
  font-weight: 300;
}

/* ===== 提交按钮 ===== */
.submit-btn {
  width: calc(100% - 48rpx);
  margin: 60rpx 24rpx 40rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  padding: 28rpx 0;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.3);
  transition: all 0.2s;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}