.page {
  min-height: 100vh;
  padding: 80rpx 48rpx 40rpx;
  background: linear-gradient(180deg, #fff7ed 0%, #f6f7f9 42%);
  box-sizing: border-box;
}

.hero {
  margin-bottom: 64rpx;
}

.brand {
  display: block;
  color: #ea580c;
  font-size: 28rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-top: 16rpx;
  font-size: 52rpx;
  font-weight: 700;
}

.desc {
  display: block;
  margin-top: 16rpx;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.6;
}

.input {
  height: 96rpx;
  margin-bottom: 24rpx;
  padding: 0 32rpx;
  background: #fff;
  border-radius: 20rpx;
  font-size: 30rpx;
}

.primary,
.ghost {
  margin-top: 12rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.primary {
  background: #f97316;
  color: #fff;
}

.ghost {
  background: #fff;
  color: #ea580c;
}

.primary::after,
.ghost::after {
  border: none;
}

.hint {
  display: block;
  margin-top: 36rpx;
  color: #9ca3af;
  font-size: 24rpx;
  text-align: center;
}
