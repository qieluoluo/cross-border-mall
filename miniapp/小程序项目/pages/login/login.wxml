<view class="page">
  <view class="hero">
    <text class="brand">Bundaberg</text>
    <text class="title">{{isRegisterMode ? '创建账户' : '欢迎回来'}}</text>
    <text class="desc">{{isRegisterMode ? '注册后即可加购和下单' : '登录后查看购物车、订单和个人资料'}}</text>
  </view>

  <view class="form">
    <input class="input" placeholder="用户名" value="{{username}}" bindinput="onUsernameInput" />
    <input class="input" placeholder="密码" password value="{{password}}" bindinput="onPasswordInput" />
    <input wx:if="{{isRegisterMode}}" class="input" placeholder="手机号" type="number" value="{{phone}}" bindinput="onPhoneInput" />

    <button class="primary" bindtap="{{isRegisterMode ? 'doRegister' : 'doLogin'}}">
      {{isRegisterMode ? '注册' : '登录'}}
    </button>
    <button class="ghost" bindtap="{{isRegisterMode ? 'goLogin' : 'goRegister'}}">
      {{isRegisterMode ? '已有账号，去登录' : '没有账号，去注册'}}
    </button>

    <text class="hint" wx:if="{{!isRegisterMode}}">演示账号：zhangwei / 123456</text>
  </view>
</view>
