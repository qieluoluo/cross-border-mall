/* pages/index/index.wxss */
page {
  background-color: #f8f8f8;
  margin: 0;
  padding: 0;
}

.container {
  padding: 0;
  margin: 0;
}

.login-type {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  padding: 30rpx 20rpx;
  background: #fff;
}

.login-type text {
  font-size: 32rpx;
  color: #999;
  padding: 16rpx 48rpx;
  border-radius: 60rpx;
}

.login-type text.active {
  background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(238,90,90,0.3);
}

.login-box {
  background: #fff;
  border-radius: 40rpx;
  padding: 60rpx 50rpx;
  margin: 100rpx 20rpx 0;
  text-align: center;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.05);
}

.admin-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 60rpx;
  color: #333;
}

.input {
  background: #f5f5f5;
  border-radius: 60rpx;
  padding: 28rpx 40rpx;
  margin-bottom: 30rpx;
  font-size: 30rpx;
}

.placeholder {
  color: #bbb;
}

.login-btn {
  background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
  color: #fff;
  border-radius: 60rpx;
  margin-top: 40rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.result {
  display: block;
  margin-top: 30rpx;
  color: #ff6b6b;
  font-size: 28rpx;
}

.search-box {
  background: #fff;
  border-radius: 60rpx;
  padding: 20rpx 30rpx;
  margin: 20rpx;
  display: flex;
  align-items: center;
  gap: 15rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.03);
}

.search-icon {
  font-size: 36rpx;
}

.search-box input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.banner {
  background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
  height: 200rpx;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 4rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  padding: 30rpx 20rpx 20rpx;
  color: #333;
}

/* 两列网格布局 */
.product-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 0 16rpx;
}

.product-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.05);
}

.product-img-wrapper {
  position: relative;
  width: 100%;
  height: 320rpx;
  overflow: hidden;
  background: #f5f5f5;
}

.product-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  z-index: 2;
}

.product-info {
  padding: 24rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-price {
  font-size: 38rpx;
  color: #ff6b6b;
  font-weight: bold;
  display: block;
  margin: 12rpx 0 8rpx;
}

.product-sales {
  font-size: 24rpx;
  color: #bbb;
}

/* ========== 单张结果：完全贴边，左右无空隙 ========== */
.single-result {
  padding: 0;
  margin: 0;
  width: 100%;
}

.single-card {
  background: #fff;
  border-radius: 0;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.05);
  margin: 0;
  width: 100%;
}

.single-img-wrapper {
  position: relative;
  width: 100%;
  height: 500rpx;
  overflow: hidden;
  background: #f5f5f5;
}

.single-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.single-info {
  padding: 30rpx;
}

.single-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.single-price {
  font-size: 48rpx;
  color: #ff6b6b;
  font-weight: bold;
  display: block;
  margin: 16rpx 0 12rpx;
}

.single-sales {
  font-size: 26rpx;
  color: #bbb;
}

.empty-search {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.load-more {
  text-align: center;
  padding: 30rpx 0 60rpx;
  color: #bbb;
  font-size: 26rpx;
}