.page {
  padding-bottom: 40rpx;
}

.search-bar {
  padding: 16rpx 24rpx 8rpx;
  background: #fff;
}

.search-box {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f3f4f6;
  border-radius: 36rpx;
}

.search-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.search-box input {
  flex: 1;
  font-size: 28rpx;
}

.placeholder {
  color: #9ca3af;
}

.banner {
  height: 320rpx;
  margin: 16rpx 24rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
}

.banner-item,
.banner-img {
  width: 100%;
  height: 320rpx;
}

.banner-item {
  position: relative;
}

.banner-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(0,0,0,0.45), rgba(0,0,0,0.05));
}

.banner-copy {
  position: absolute;
  left: 32rpx;
  bottom: 36rpx;
  color: #fff;
}

.banner-tag {
  display: block;
  font-size: 22rpx;
  opacity: 0.9;
}

.banner-title {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.category-row {
  display: flex;
  justify-content: space-between;
  margin: 24rpx;
  padding: 24rpx 12rpx;
  background: #fff;
  border-radius: 24rpx;
}

.category-item {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #4b5563;
}

.category-icon {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto 10rpx;
  line-height: 72rpx;
  background: #fff7ed;
  border-radius: 50%;
  font-size: 32rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 8rpx 28rpx 16rpx;
}

.section-label {
  display: block;
  font-size: 22rpx;
  color: #f97316;
}

.section-title {
  display: block;
  margin-top: 6rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.section-count {
  font-size: 24rpx;
  color: #9ca3af;
}

.product-list {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
}

.product-card {
  width: calc(50% - 16rpx);
  margin: 8rpx;
  overflow: hidden;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.04);
}

.product-img {
  width: 100%;
  height: 300rpx;
  background: #f3f4f6;
}

.product-info {
  padding: 18rpx 18rpx 22rpx;
}

.product-name {
  display: block;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.product-sub {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: #9ca3af;
  font-size: 22rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.product-bottom {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 16rpx;
}

.product-price {
  color: #ea580c;
  font-size: 34rpx;
  font-weight: 700;
}

.product-sales {
  color: #9ca3af;
  font-size: 20rpx;
}

.empty,
.load-more {
  padding: 80rpx 0 40rpx;
  color: #9ca3af;
  font-size: 26rpx;
  text-align: center;
}
