<view class="page">
  <view class="search-bar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input
        placeholder="搜索手机、服饰、家电"
        placeholder-class="placeholder"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
        confirm-type="search"
      />
    </view>
  </view>

  <swiper class="banner" autoplay circular interval="4500" indicator-dots indicator-color="rgba(255,255,255,0.45)" indicator-active-color="#ffffff">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <view class="banner-item" bindtap="goToCategory" data-id="{{item.categoryId}}">
        <image class="banner-img" src="{{item.image}}" mode="aspectFill"></image>
        <view class="banner-mask"></view>
        <view class="banner-copy">
          <text class="banner-tag">{{item.tag}}</text>
          <text class="banner-title">{{item.title}}</text>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="category-row">
    <view class="category-item" wx:for="{{categories}}" wx:key="id" bindtap="goToCategory" data-id="{{item.id}}">
      <view class="category-icon">{{item.icon}}</view>
      <text>{{item.name}}</text>
    </view>
  </view>

  <view class="section-head">
    <view>
      <text class="section-label">本周推荐</text>
      <text class="section-title">热门商品</text>
    </view>
    <text class="section-count">共 {{displayProductList.length}} 件</text>
  </view>

  <view class="product-list" wx:if="{{displayProductList.length > 0}}">
    <view class="product-card" wx:for="{{displayProductList}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <image class="product-img" src="{{item.mainImage}}" mode="aspectFill" lazy-load binderror="onImageError" data-index="{{index}}"></image>
      <view class="product-info">
        <text class="product-name">{{item.name}}</text>
        <text class="product-sub">{{item.subTitle || item.sub_title || '优选好物'}}</text>
        <view class="product-bottom">
          <text class="product-price">¥{{item.price}}</text>
          <text class="product-sales">已售 {{item.sales || 0}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <text>{{searchKeyword ? '没有找到相关商品' : '暂无商品，请确认商品服务已启动'}}</text>
  </view>

  <view class="load-more" wx:if="{{loading}}">加载中...</view>
  <view class="load-more" wx:elif="{{noMore && displayProductList.length > 0 && !isSearching}}">已经到底了</view>
</view>
