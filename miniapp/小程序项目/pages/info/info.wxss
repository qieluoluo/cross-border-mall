/* pages/info/info.wxss */
page {
  background-color: #f5f5f5;
}

.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 标签页 */
.tabs {
  display: flex;
  background-color: #fff;
  padding: 20rpx 0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 32rpx;  /* 增大字号 */
  color: #666;
  padding: 20rpx 0;
  position: relative;
}

.tab.active {
  color: #ff6b6b;
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
  border-radius: 2rpx;
}

.tab-content {
  padding: 30rpx 30rpx;  /* 增加左右内边距 */
}

/* 表单样式 */
.form-group {
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 30rpx 30rpx;  /* 增加内边距 */
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.label {
  width: 150rpx;  /* 稍微加宽标签宽度 */
  font-size: 30rpx;  /* 增大字号 */
  color: #333;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 30rpx;  /* 增大字号 */
  color: #333;
}

.save-btn {
  background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
  color: #fff;
  border-radius: 50rpx;
  margin-top: 40rpx;
  font-size: 32rpx;  /* 增大字号 */
  padding: 28rpx 0;  /* 增加按钮高度 */
}

/* 地址列表 - 优化部分 */
.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #fff;
  padding: 40rpx;  /* 增加内边距 */
  border-radius: 20rpx;  /* 增大圆角 */
  margin-bottom: 30rpx;  /* 增加下边距 */
  border: 2rpx dashed #ddd;
  transition: all 0.3s;
}

.add-btn:active {
  background-color: #f9f9f9;
  transform: scale(0.98);
}

.add-icon {
  font-size: 48rpx;  /* 增大图标 */
  color: #ff6b6b;
  margin-right: 15rpx;  /* 增加间距 */
  font-weight: bold;
}

.address-list {
  margin-top: 20rpx;
}

.address-item {
  background-color: #fff;
  padding: 35rpx 30rpx;  /* 增加上下左右内边距 */
  border-radius: 20rpx;  /* 增大圆角 */
  margin-bottom: 25rpx;  /* 增加卡片间距 */
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);  /* 添加轻微阴影 */
  transition: all 0.3s;
}

.address-item:active {
  transform: scale(0.99);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.address-top {
  display: flex;
  align-items: baseline;  /* 改为 baseline 更对齐 */
  margin-bottom: 20rpx;  /* 增加间距 */
  flex-wrap: wrap;  /* 允许换行 */
  gap: 15rpx;  /* 元素间距 */
}

.receiver {
  font-size: 34rpx;  /* 增大字号 */
  font-weight: bold;
  color: #333;
  margin-right: 0;  /* 移除右边距，用 gap 代替 */
}

.phone {
  font-size: 30rpx;  /* 增大字号 */
  color: #888;  /* 调整颜色 */
}

.default-tag {
  padding: 8rpx 20rpx;  /* 增加内边距 */
  background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
  color: #fff;
  font-size: 24rpx;  /* 增大字号 */
  border-radius: 30rpx;  /* 增大圆角 */
  margin-left: auto;
  flex-shrink: 0;
}

.address-detail {
  font-size: 28rpx;  /* 增大字号 */
  color: #666;
  line-height: 1.6;
  margin-bottom: 25rpx;  /* 增加间距 */
  padding: 10rpx 0;  /* 增加内边距 */
  word-break: break-all;  /* 长文本换行 */
}

.address-actions {
  display: flex;
  gap: 30rpx;  /* 增加按钮间距 */
  border-top: 1rpx solid #f0f0f0;
  padding-top: 25rpx;  /* 增加上内边距 */
  margin-top: 5rpx;
}

.action-btn {
  font-size: 28rpx;  /* 增大字号 */
  color: #666;
  padding: 8rpx 0;  /* 增加点击区域 */
  position: relative;
}

.action-btn:active {
  opacity: 0.6;
}

.action-btn.delete {
  color: #ff6b6b;
  margin-left: auto;
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 30rpx;  /* 增大字号 */
  padding: 120rpx 0;  /* 增加内边距 */
}

/* 地址编辑弹窗 */
.edit-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-content {
  width: 650rpx;  /* 增加弹窗宽度 */
  background-color: #fff;
  border-radius: 24rpx;  /* 增大圆角 */
  padding: 50rpx 40rpx;  /* 增加内边距 */
  max-height: 85vh;
  overflow-y: auto;
}

.modal-title {
  font-size: 36rpx;  /* 增大字号 */
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 50rpx;  /* 增加间距 */
}

.checkbox-group {
  justify-content: flex-start;
}

.modal-buttons {
  display: flex;
  gap: 25rpx;  /* 增加按钮间距 */
  margin-top: 50rpx;  /* 增加上间距 */
}

.modal-buttons button {
  flex: 1;
  border-radius: 50rpx;
  font-size: 30rpx;  /* 增大字号 */
  padding: 25rpx 0;  /* 增加按钮高度 */
}

.modal-buttons .cancel-btn {
  background-color: #f5f5f5;
  color: #666;
  margin-top: 0;  /* 移除多余的 margin-top */
}

.modal-buttons .cancel-btn:active {
  background-color: #e8e8e8;
}

.modal-buttons .save-btn {
  background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
  color: #fff;
}

.modal-buttons .save-btn:active {
  opacity: 0.8;
}