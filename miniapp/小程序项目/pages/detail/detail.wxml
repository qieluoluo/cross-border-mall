<view class="page">
  <image class="cover" src="{{product.mainImage}}" mode="aspectFill" binderror="onImageError"></image>

  <view class="card">
    <text class="price">¥{{product.price}}</text>
    <text class="name">{{product.name}}</text>
    <text class="sub">{{product.subTitle || '优选品质，方便日常选购'}}</text>
    <view class="meta">
      <text>销量 {{product.sales || 0}}</text>
      <text>库存 {{product.stock || 0}}</text>
    </view>
  </view>

  <view class="card desc-card">
    <text class="desc-title">商品详情</text>
    <text class="desc">{{product.detailHtml || '暂无详细描述'}}</text>
  </view>

  <view class="bottom">
    <button class="cart-btn" bindtap="addToCart">加入购物车</button>
  </view>
</view>
