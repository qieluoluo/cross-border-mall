/* pages/detail/detail.wxss */
page {
  background-color: #f8f8f8;
  margin: 0;
  padding: 0;
}

.container {
  padding: 0;
  padding-bottom: 130rpx;
}

.image-wrapper {
  width: 100%;
  height: 500rpx;
  background: #f5f5f5;
  overflow: hidden;
  margin: 0;
  padding: 0;
}

.product-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.product-info {
  padding: 30rpx;
  background: #fff;
  margin-top: 20rpx;
}

.product-name {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
  color: #333;
}

.product-price {
  font-size: 40rpx;
  color: #ff4444;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

.product-stock {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}

.product-desc {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
}

.add-cart-btn {
  background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
  color: #fff;
  border-radius: 60rpx;
  font-size: 32rpx;
  font-weight: bold;
}