.page {
  padding-bottom: 180rpx;
}

.cover {
  width: 100%;
  height: 560rpx;
  background: #f3f4f6;
}

.card {
  margin: 20rpx 24rpx 0;
  padding: 28rpx;
  background: #fff;
  border-radius: 24rpx;
}

.price {
  display: block;
  color: #ea580c;
  font-size: 44rpx;
  font-weight: 700;
}

.name {
  display: block;
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.sub {
  display: block;
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 26rpx;
}

.meta {
  display: flex;
  gap: 32rpx;
  margin-top: 20rpx;
  color: #9ca3af;
  font-size: 24rpx;
}

.qty-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.qty-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.stepper {
  display: flex;
  align-items: center;
  overflow: hidden;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
}

.stepper-btn {
  width: 64rpx;
  height: 56rpx;
  line-height: 56rpx;
  color: #374151;
  font-size: 36rpx;
  text-align: center;
  background: #f9fafb;
}

.stepper-btn.disabled {
  color: #d1d5db;
}

.stepper-num {
  min-width: 72rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  border-left: 1rpx solid #e5e7eb;
  border-right: 1rpx solid #e5e7eb;
}

.desc-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.desc {
  color: #4b5563;
  font-size: 26rpx;
  line-height: 1.7;
}

.bottom {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -6rpx 20rpx rgba(15, 23, 42, 0.06);
}

.cart-btn,
.buy-btn {
  flex: 1;
  margin: 0;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 48rpx;
}

.cart-btn {
  background: #fff7ed;
  color: #ea580c;
}

.buy-btn {
  background: #f97316;
  color: #fff;
}

.btn-hover {
  opacity: 0.88;
}

.cart-btn::after,
.buy-btn::after {
  border: none;
}
