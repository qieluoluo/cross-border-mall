.page {
  padding-bottom: 160rpx;
}

.cover {
  width: 100%;
  height: 560rpx;
  background: #f3f4f6;
}

.card {
  margin: 20rpx 24rpx 0;
  padding: 28rpx;
  background: #fff;
  border-radius: 24rpx;
}

.price {
  display: block;
  color: #ea580c;
  font-size: 44rpx;
  font-weight: 700;
}

.name {
  display: block;
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.sub {
  display: block;
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 26rpx;
}

.meta {
  display: flex;
  gap: 32rpx;
  margin-top: 20rpx;
  color: #9ca3af;
  font-size: 24rpx;
}

.desc-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.desc {
  color: #4b5563;
  font-size: 26rpx;
  line-height: 1.7;
}

.bottom {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -6rpx 20rpx rgba(15, 23, 42, 0.06);
}

.cart-btn {
  background: #f97316;
  color: #fff;
  border-radius: 48rpx;
  font-weight: 600;
}

.cart-btn::after {
  border: none;
}
