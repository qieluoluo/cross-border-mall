/* pages/cart/cart.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 商品列表 */
.cart-list {
  padding: 20rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.item-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}

.item-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ea580c;
}

.item-quantity {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.quantity-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 40rpx;
  color: #666;
}

.quantity-num {
  font-size: 32rpx;
  color: #333;
  min-width: 60rpx;
  text-align: center;
}

/* 底部结算栏 */
.total-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: white;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}

.total-info {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 28rpx;
  color: #666;
}

.total-price {
  font-size: 44rpx;
  font-weight: bold;
  color: #ea580c;
}

.checkout-btn {
  background: #f97316;
  color: white;
  font-size: 32rpx;
  padding: 16rpx 48rpx;
  border-radius: 48rpx;
  border: none;
}

.checkout-btn::after {
  border: none;
}

/* 空购物车 */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 300rpx;
}

.empty-emoji {
  margin-bottom: 24rpx;
  font-size: 80rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 60rpx;
}

.go-shopping-btn {
  background: #f97316;
  color: white;
  font-size: 32rpx;
  padding: 20rpx 60rpx;
  border-radius: 48rpx;
  width: auto;
}

/* 弹窗遮罩 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/* 结算弹窗容器 */
.modal-container {
  width: 100%;
  max-height: 80vh;
  background: white;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 44rpx;
  color: #999;
}

.modal-content {
  flex: 1;
  overflow-y: auto;
  padding: 30rpx;
}

/* 地址选择器容器 */
.address-picker-container {
  width: 100%;
  max-height: 80vh;
  background: white;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
}

.address-list {
  flex: 1;
  max-height: 60vh;
}

.address-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.address-info {
  flex: 1;
}

.address-name {
  font-size: 32rpx;
  font-weight: 500;
  margin-right: 20rpx;
}

.address-phone {
  font-size: 28rpx;
  color: #666;
}

.address-detail {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-top: 12rpx;
}

.address-check {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f97316;
  color: white;
  border-radius: 50%;
  font-size: 32rpx;
}

.address-section {
  display: flex;
  align-items: center;
  background: #fafafa;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
}

.address-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.address-info {
  flex: 1;
}

.address-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.order-items {
  margin-bottom: 30rpx;
}

.order-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-item-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.order-item-info {
  flex: 1;
}

.order-item-name {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.order-item-price {
  font-size: 32rpx;
  color: #ea580c;
}

.order-item-quantity {
  font-size: 28rpx;
  color: #999;
}

.order-total {
  display: flex;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  font-size: 32rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.cancel-btn,
.confirm-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666;
}

.confirm-btn {
  background: #f97316;
  color: white;
}

.picker-footer {
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.add-address-btn {
  background: #f97316;
  color: white;
  font-size: 32rpx;
  border-radius: 48rpx;
}