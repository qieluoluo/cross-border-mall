.page {
  min-height: 100vh;
  background: #f6f7f9;
}

.user-card {
  display: flex;
  align-items: center;
  padding: 48rpx 36rpx 56rpx;
  background: linear-gradient(135deg, #fb923c, #ea580c);
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  margin-right: 28rpx;
  border: 6rpx solid rgba(255,255,255,0.45);
  border-radius: 50%;
  background: #fff;
}

.nickname {
  display: block;
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
}

.edit-tip {
  display: block;
  margin-top: 10rpx;
  color: rgba(255,255,255,0.8);
  font-size: 24rpx;
}

.menu {
  margin: 24rpx;
  overflow: hidden;
  background: #fff;
  border-radius: 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #f3f4f6;
  font-size: 30rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.arrow {
  color: #d1d5db;
  font-size: 40rpx;
}

.danger {
  color: #dc2626;
}
