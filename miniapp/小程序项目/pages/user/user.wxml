<!-- pages/user/user.wxml -->
<view class="container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="avatar-area" bindtap="chooseAvatar">
      <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
      <text class="avatar-tip">点击更换头像</text>
    </view>
    <view class="nickname-area" bindtap="editNickname">
      <text class="nickname">{{userInfo.nickName}}</text>
      <text class="edit-tip">点击编辑</text>
    </view>
  </view>

  <view class="spacer"></view>

  <!-- 订单入口 -->
  <view class="menu-item" bindtap="goToOrders" style="width: 297rpx; display: flex; box-sizing: border-box">
    <text>我的订单</text>
    <text class="arrow">></text>
  </view>

  <!-- 个人信息入口 -->
  <view class="menu-item" bindtap="goToInfo" style="width: 297rpx; display: flex; box-sizing: border-box">
    <text>个人信息</text>
    <text class="arrow">></text>
  </view>

  <!-- 联系客服 -->
  <view class="menu-item" bindtap="contactService" style="width: 297rpx; display: flex; box-sizing: border-box">
    <text>联系客服</text>
    <text class="arrow">></text>
  </view>

  <!-- 退出登录（原清除缓存） -->
  <view class="menu-item" bindtap="logout" style="width: 297rpx; display: flex; box-sizing: border-box">
    <text>退出登录</text>
    <text class="arrow">></text>
  </view>

  <!-- 版本信息 -->
  <view class="version">
    <text>版本 1.0.0</text>
  </view>
</view>