<view class="page">
  <view class="user-card">
    <view class="avatar-area" bindtap="chooseAvatar">
      <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" binderror="onImageError"></image>
    </view>
    <view class="nickname-area" bindtap="editNickname">
      <text class="nickname">{{userInfo.nickName}}</text>
      <text class="edit-tip">点击修改昵称</text>
    </view>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="goToOrders">
      <text>我的订单</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToInfo">
      <text>收货地址</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="contactService">
      <text>联系客服</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item danger" bindtap="logout">
      <text>退出登录</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
