<view class="page">
  <block wx:if="{{orderList.length > 0}}">
    <view class="order-card" wx:for="{{orderList}}" wx:key="id" wx:for-index="orderIndex">
      <view class="order-header">
        <text class="order-no">订单号 {{item.orderNo}}</text>
        <text class="status">{{item.statusText}}</text>
      </view>

      <view class="goods-list">
        <block wx:if="{{item.items && item.items.length}}">
          <view class="goods" wx:for="{{item.items}}" wx:key="id" wx:for-item="goods" wx:for-index="goodsIndex">
            <image class="goods-img" src="{{goods.productImage}}" mode="aspectFill" binderror="onImageError" data-order-index="{{orderIndex}}" data-goods-index="{{goodsIndex}}"></image>
            <view class="goods-main">
              <text class="goods-name">{{goods.productName || '商品'}}</text>
              <text class="goods-qty" wx:if="{{goods.specs}}">{{goods.specs}} · x{{goods.quantity || 1}}</text>
              <text class="goods-qty" wx:else>x{{goods.quantity || 1}}</text>
            </view>
            <text class="goods-price">¥{{goods.price}}</text>
          </view>
        </block>
        <view class="goods" wx:else>
          <text class="goods-name">订单商品</text>
          <text class="goods-price">¥{{item.payAmount || item.totalAmount}}</text>
        </view>
      </view>

      <view class="order-footer">
        <view class="pay-info">
          <text class="pay-label">实付</text>
          <text class="pay-text">¥{{item.payAmount || item.totalAmount}}</text>
        </view>
        <button
          class="pay-btn"
          wx:if="{{item.status === 0}}"
          hover-class="pay-btn-hover"
          bindtap="goPay"
          data-order-id="{{item.id}}"
          data-total-price="{{item.payAmount || item.totalAmount}}"
        >去支付</button>
      </view>
    </view>
  </block>

  <view class="empty" wx:else>
    <text>还没有订单</text>
    <button class="ghost" bindtap="goHome">去首页看看</button>
  </view>
</view>
