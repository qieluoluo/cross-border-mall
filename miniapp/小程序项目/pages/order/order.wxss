.page {
  padding: 20rpx 24rpx 40rpx;
}

.order-card {
  margin-bottom: 20rpx;
  overflow: hidden;
  background: #fff;
  border-radius: 20rpx;
}

.order-header,
.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
}

.order-header {
  background: #fafafa;
}

.order-no {
  color: #6b7280;
  font-size: 24rpx;
}

.status {
  color: #ea580c;
  font-size: 24rpx;
  font-weight: 600;
}

.goods {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}

.goods-img {
  width: 112rpx;
  height: 112rpx;
  margin-right: 16rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
}

.goods-main {
  flex: 1;
}

.goods-name {
  display: block;
  font-size: 28rpx;
}

.goods-qty {
  color: #9ca3af;
  font-size: 22rpx;
}

.goods-price,
.pay-text {
  color: #ea580c;
  font-weight: 700;
}

.pay-btn {
  background: #f97316;
  color: #fff;
  border-radius: 28rpx;
}

.pay-btn::after {
  border: none;
}

.empty {
  padding: 160rpx 0;
  color: #9ca3af;
  text-align: center;
}

.ghost {
  width: 280rpx;
  margin-top: 24rpx;
  background: #fff;
  color: #ea580c;
  border-radius: 40rpx;
}
