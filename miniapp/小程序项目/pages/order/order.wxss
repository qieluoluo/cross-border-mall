.page {
  padding: 20rpx 24rpx 40rpx;
}

.order-card {
  margin-bottom: 20rpx;
  overflow: hidden;
  background: #fff;
  border-radius: 20rpx;
}

.order-header,
.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
}

.order-header {
  background: #fafafa;
}

.order-no {
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
  color: #6b7280;
  font-size: 24rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.status {
  flex-shrink: 0;
  color: #ea580c;
  font-size: 24rpx;
  font-weight: 600;
}

.goods {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}

.goods-img {
  width: 112rpx;
  height: 112rpx;
  margin-right: 16rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.goods-main {
  flex: 1;
  min-width: 0;
}

.goods-name {
  display: block;
  overflow: hidden;
  font-size: 28rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.goods-qty {
  color: #9ca3af;
  font-size: 22rpx;
}

.goods-price {
  flex-shrink: 0;
  margin-left: 12rpx;
  color: #ea580c;
  font-weight: 700;
}

.order-footer {
  border-top: 1rpx solid #f3f4f6;
}

.pay-info {
  display: flex;
  flex: 1;
  align-items: baseline;
  min-width: 0;
}

.pay-label {
  margin-right: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.pay-text {
  color: #ea580c;
  font-size: 32rpx;
  font-weight: 700;
}

.pay-btn {
  width: 168rpx !important;
  min-width: 168rpx;
  height: 64rpx;
  margin: 0 0 0 16rpx !important;
  padding: 0;
  line-height: 64rpx;
  background: #f97316;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 32rpx;
  flex-shrink: 0;
}

.pay-btn-hover {
  opacity: 0.88;
}

.pay-btn::after {
  border: none;
}

.empty {
  padding: 160rpx 0;
  color: #9ca3af;
  text-align: center;
}

.ghost {
  width: 280rpx;
  margin-top: 24rpx;
  background: #fff;
  color: #ea580c;
  border-radius: 40rpx;
}
