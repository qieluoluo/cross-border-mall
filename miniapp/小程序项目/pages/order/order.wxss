/* pages/order/order.wxss */
page {
  background: #f5f5f5;
}

.container {
  padding: 20rpx;
  background: #f5f5f5;
}

.order-item {
  background: #fff;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1px solid #ddd;
  width: 100%;
  box-sizing: border-box;
}

.order-header {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  font-size: 28rpx;
  color: #333;
  background: #fafafa;
  border-bottom: 1px solid #eee;
}

.status {
  color: #ff4444;
}

.order-goods {
  padding: 24rpx 20rpx;
  min-height: 80rpx;
}

.goods-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.goods-price {
  font-size: 28rpx;
  color: #ff4444;
  text-align: right;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-top: 1px solid #eee;
  background: #fff;
  min-height: 100rpx;
}

.btn-group {
  display: flex;
  gap: 20rpx;
}

.logistics-btn {
  background: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  padding: 0 24rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
}

.pay-btn {
  background: #ff4444;
  color: #fff;
  font-size: 26rpx;
  padding: 0 24rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
}

.empty-order {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}